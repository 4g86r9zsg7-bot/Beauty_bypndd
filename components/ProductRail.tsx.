'use client';import {useEffect,useRef,useState} from 'react';import Link from 'next/link';import ProductCard from '@/components/ProductCard';
const rank=(p:any)=>{const pre=p.availability==='preorder',arr=p.availability==='arrival';return p.availability==='soldout'||(!pre&&!arr&&p.stock<=0)?2:(pre||arr)?1:0};
const shuffle=<T,>(a:T[])=>{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
export default function ProductRail({title,href,items}:{title:string;href?:string;items:any[]}){
const [list,setList]=useState<any[]>(items);const [ready,setReady]=useState(false);const [more,setMore]=useState(true);const ref=useRef<HTMLDivElement>(null);const hold=useRef(false);
useEffect(()=>{setList([0,1,2].flatMap(r=>shuffle(items.filter(p=>rank(p)===r))));setReady(true)},[items]);
useEffect(()=>{const el=ref.current;if(!el||!ready)return;const m=()=>setMore(el.scrollWidth>el.clientWidth+8);m();window.addEventListener('resize',m);
const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const id=reduce?0:window.setInterval(()=>{if(hold.current||document.hidden||el.scrollWidth<=el.clientWidth+8)return;const end=el.scrollLeft+el.clientWidth>=el.scrollWidth-8;if(end)el.scrollTo({left:0,behavior:'smooth'});else el.scrollBy({left:el.clientWidth*0.9,behavior:'smooth'})},6500);
return()=>{window.removeEventListener('resize',m);if(id)clearInterval(id)}},[ready,list]);
const go=(d:number)=>{const el=ref.current;if(!el)return;const end=el.scrollLeft+el.clientWidth>=el.scrollWidth-8;if(d>0&&end)el.scrollTo({left:0,behavior:'smooth'});else if(d<0&&el.scrollLeft<=8)el.scrollTo({left:el.scrollWidth,behavior:'smooth'});else el.scrollBy({left:d*el.clientWidth*0.9,behavior:'smooth'})};
const arrow="absolute top-24 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-plum shadow-md backdrop-blur transition hover:bg-white active:scale-90 sm:top-32";
return <section className="mt-12"><div className="mb-5 text-center"><h2 className="font-serif text-3xl text-plum">{title}</h2><div className="mx-auto mt-3 h-px w-16 bg-rose"/>{href&&<Link href={href} className="mt-3 inline-block text-[11px] uppercase tracking-[0.2em] text-rose">Tout voir</Link>}</div>
<div className="relative" onPointerEnter={()=>{hold.current=true}} onPointerLeave={()=>{hold.current=false}} onTouchStart={()=>{hold.current=true}} onTouchEnd={()=>{setTimeout(()=>{hold.current=false},5000)}}>
{more&&<><button type="button" aria-label="Produits précédents" onClick={()=>go(-1)} className={`${arrow} left-1`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" aria-label="Produits suivants" onClick={()=>go(1)} className={`${arrow} right-1`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M9 5l7 7-7 7"/></svg></button></>}
<div ref={ref} className={`flex snap-x snap-mandatory gap-x-3 overflow-x-auto scroll-smooth pb-2 transition-opacity duration-500 md:gap-x-5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden ${ready?'opacity-100':'opacity-0'}`}>{list.map(p=><div key={p.id} className="w-[46%] shrink-0 snap-start sm:w-[31%] lg:w-[23.5%]"><ProductCard p={p}/></div>)}</div></div></section>}
